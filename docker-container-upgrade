#!/usr/bin/env bash
#
# docker-container-upgrade - keep a container on the newest version tag of its image.
#
# Usage:
#   docker-container-upgrade --name <container> --repo <repo> [--minor-only] [--dry-run] [-- <docker run args>]
#
# The container is started with:
#   docker run -d --name=<container> --restart unless-stopped <docker run args> <repo>:<version>
#
# Progress goes to stdout, errors to stderr. Requires docker, skopeo and jq.
#
# Exit status:
#   0  no upgrade found
#   1  error
#   3  upgrade found and done (or, with --dry-run, would be done)
#   4  upgrade found but blocked (major upgrade with --minor-only)

set -euo pipefail

log()   { echo "$*"; }
error() { echo "$*" >&2; exit 1; }

trap 'error "Failed at line $LINENO"' ERR

name="" repo="" minor_only=false dry_run=false
while (($#)); do
    case "$1" in
        --name)       name="$2"; shift 2 ;;
        --repo)       repo="$2"; shift 2 ;;
        --minor-only) minor_only=true; shift ;;
        --dry-run)    dry_run=true; shift ;;
        --)           shift; break ;;
        *)            error "Unknown argument: $1" ;;
    esac
done
if [[ -z $name || -z $repo ]]; then
    error "usage: $0 --name <container> --repo <repo> [--minor-only] [--dry-run] [-- <docker run args>]"
fi

# Version tags are 3+ dot-separated numbers (1.12.2, 8.2.7.0, 2026.11.2), sorted oldest first.
version_re='^[0-9]+(\.[0-9]+){2,}$'
log "Checking container $name ($repo) for upgrades"
versions=$(skopeo list-tags "docker://$repo" | jq -r '.Tags[]' | { grep -E "$version_re" || true; } | sort -V)
if [[ -z $versions ]]; then
    error "No version tags found for $repo"
fi
log "Newest version: $(tail -n1 <<<"$versions")"

# Current image and tag of the container, empty if it doesn't exist.
current=$(docker container inspect -f '{{.Config.Image}}' "$name" 2>/dev/null || true)
current_tag=${current##*:}
from=${current:+$current_tag}
if [[ -n $current ]]; then
    log "Container $name is running $current"
else
    log "Container $name not found"
fi

target="" blocked=""
if [[ ! $current_tag =~ $version_re ]]; then
    # No container yet, or running on a tag like latest/stable: use the newest version.
    target=$(tail -n1 <<<"$versions")
else
    for v in $versions; do
        # Skip versions that aren't newer than the current one.
        [[ $v != "$current_tag" && $(printf '%s\n' "$v" "$current_tag" | sort -V | tail -n1) == "$v" ]] || continue
        if $minor_only && [[ ${v%%.*} != "${current_tag%%.*}" ]]; then
            blocked=$v
        else
            target=$v
        fi
    done
fi

if [[ -n $blocked ]]; then
    log "Major upgrade available: $blocked (not installed, --minor-only)"
fi
if [[ -z $target && -n $blocked ]]; then
    exit 4
fi
if [[ -z $target ]]; then
    log "Already up to date"
    exit 0
fi
if $dry_run; then
    log "Would upgrade: ${from:-not running} -> $target (dry run)"
    exit 3
fi

log "Upgrading: ${from:-not running} -> $target"
log "Pulling $repo:$target"
docker pull "$repo:$target"
if [[ -n $current ]]; then
    log "Stopping and removing the old container"
    docker stop "$name"
    docker rm "$name"
fi
log "Starting $name"
docker run -d --name="$name" --restart unless-stopped "$@" "$repo:$target"
log "Upgraded to $target"
if [[ -n $current ]]; then
    log "Removing old image $current"
    docker rmi "$current"
fi
exit 3
